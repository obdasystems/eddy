     xmlns:CLV="https://w3id.org/italia/onto/CLV/"
     xmlns:COV="https://w3id.org/italia/onto/COV/"
     xmlns:CPV="https://w3id.org/italia/onto/CPV/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:smapit="https://w3id.org/italia/onto/SM/"
     xmlns:countries="http://w3id.org/italia/controlled-vocabulary/territorial-classifications/countries/"
     xmlns:ateco-2007="https://w3id.org/italia/controlled-vocabulary/classifications-for-organizations/ateco-2007/"
