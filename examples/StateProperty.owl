    <!-- https://w3id.org/italia/real-estate/onto/StateProperty/haCategoriaBene -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/real-estate/onto/StateProperty/haCategoriaBene">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/real-estate/onto/StateProperty/SchedaCatalogazioneBene"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/real-estate/onto/StateProperty/CategoriaBeneImmobile"/>
        <rdfs:label xml:lang="it">ha categoria bene dello Stato</rdfs:label>
        <rdfs:label xml:lang="en">has category State Property</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/real-estate/onto/StateProperty/haCategoriaPatrimoniale -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/real-estate/onto/StateProperty/haCategoriaPatrimoniale">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/real-estate/onto/StateProperty/StatoBeneImmobile"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/real-estate/onto/StateProperty/TipoCategoriaPatrimonialeImmobile"/>
        <rdfs:label xml:lang="it">ha categoria patrimoniale</rdfs:label>
        <rdfs:label xml:lang="en">has asset category</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/real-estate/onto/StateProperty/haCodiceSEC -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/real-estate/onto/StateProperty/haCodiceSEC">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/real-estate/onto/StateProperty/BeneImmobileDelloStato"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/real-estate/onto/StateProperty/CodiceMEFRaccordoSECBeneImmobile"/>
        <rdfs:label xml:lang="it">ha codice SEC</rdfs:label>
        <rdfs:label xml:lang="en">has ESA code</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/real-estate/onto/StateProperty/haDestinazioneUso -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/real-estate/onto/StateProperty/haDestinazioneUso">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/real-estate/onto/StateProperty/StatoBeneImmobile"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/real-estate/onto/StateProperty/TipoDestinazioneUsoImmobile"/>
        <rdfs:label xml:lang="it">ha destinazione di uso</rdfs:label>
        <rdfs:label xml:lang="en">has designed use</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/real-estate/onto/StateProperty/haSchedaCatalogazione -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/real-estate/onto/StateProperty/haSchedaCatalogazione">
        <rdfs:domain rdf:resource="https://w3id.org/italia/real-estate/onto/StateProperty/BeneImmobileDelloStato"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/real-estate/onto/StateProperty/SchedaCatalogazioneBene"/>
        <rdfs:label xml:lang="it">ha scheda di catalogazione</rdfs:label>
        <rdfs:label xml:lang="en">has a catalog record</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/real-estate/onto/StateProperty/haStatoAgibilità -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/real-estate/onto/StateProperty/haStatoAgibilità">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/real-estate/onto/StateProperty/StatoBeneImmobile"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/real-estate/onto/StateProperty/TipoStatoAgibilitàImmobile"/>
        <rdfs:label xml:lang="it">ha stato di agibilità</rdfs:label>
        <rdfs:label xml:lang="en">has status of habitability</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/real-estate/onto/StateProperty/haStatoDelBeneImmobile -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/real-estate/onto/StateProperty/haStatoDelBeneImmobile">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/real-estate/onto/StateProperty/BeneImmobileDelloStato"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/real-estate/onto/StateProperty/StatoBeneImmobile"/>
        <rdfs:label xml:lang="it">ha stato del bene immobile dello Stato</rdfs:label>
        <rdfs:label xml:lang="en">has status the property real-estate</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/real-estate/onto/StateProperty/haStatoOccupazione -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/real-estate/onto/StateProperty/haStatoOccupazione">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/real-estate/onto/StateProperty/StatoBeneImmobile"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/real-estate/onto/StateProperty/TipoStatoOccupazioneImmobile"/>
        <rdfs:label xml:lang="it">ha stato di occupazione</rdfs:label>
        <rdfs:label xml:lang="en">has occupation status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/real-estate/onto/StateProperty/haTipoAccesso -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/real-estate/onto/StateProperty/haTipoAccesso">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/real-estate/onto/StateProperty/StatoBeneImmobile"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/real-estate/onto/StateProperty/TipoAccessoImmobile"/>
        <rdfs:label xml:lang="it">ha tipo di accesso</rdfs:label>
        <rdfs:label xml:lang="en">has access type</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/italia/real-estate/onto/StateProperty/riferisceProvincia -->

    <owl:ObjectProperty rdf:about="https://w3id.org/italia/real-estate/onto/StateProperty/riferisceProvincia">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/italia/real-estate/onto/StateProperty/SchedaCatalogazioneBene"/>
        <rdfs:range rdf:resource="https://w3id.org/italia/onto/CLV/Province"/>
        <rdfs:label xml:lang="en">related to province</rdfs:label>
        <rdfs:label xml:lang="it">riferisce provincia</rdfs:label>
    </owl:ObjectProperty>
    


